# quitar_paginas.py
from pypdf import PdfReader, PdfWriter

ENTRADA = "documento.pdf"      # nombre de tu PDF
SALIDA = "documento_recortado.pdf"
DESDE, HASTA = 3, 23           # páginas a quitar (numeradas desde 1, inclusive)

reader = PdfReader(ENTRADA)
writer = PdfWriter()

for i, pagina in enumerate(reader.pages, start=1):
    if not (DESDE <= i <= HASTA):
        writer.add_page(pagina)

with open(SALIDA, "wb") as f:
    writer.write(f)

print(f"Listo: {len(reader.pages)} páginas originales → {len(writer.pages)} en {SALIDA}")
